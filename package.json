{
  "name": "pxm",
  "private": true,
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "db:mongo": "docker compose -f infra/docker-compose.yml up -d mongodb",
    "db:mongo:reset": "docker compose -f infra/docker-compose.yml down -v && docker compose -f infra/docker-compose.yml up -d mongodb",
    "db:mongo:init": "cd apps/api && MONGODB_URL=${MONGODB_URL:-mongodb://127.0.0.1:27017/?replicaSet=rs0} MONGO_DB_NAME=${MONGO_DB_NAME:-pxm_db} node scripts/init-mongo-indexes.mjs",
    "db:mongo:check": "cd apps/api && MONGODB_URL=${MONGODB_URL:-mongodb://127.0.0.1:27017/?replicaSet=rs0} MONGO_DB_NAME=${MONGO_DB_NAME:-pxm_db} node scripts/check-mongo-runtime-contracts.mjs",
    "plugin:install": "cd apps/api && node scripts/install-plugin-manifest.mjs",
    "plugin:conformance": "cd apps/api && node scripts/plugin-conformance.mjs",
    "plugin:control": "cd apps/api && node scripts/plugin-control.mjs",
    "demo:sse:approval": "cd apps/api && node scripts/demo-sse-approval-stream.mjs",
    "demo:external-email-approval": "cd apps/api && node scripts/create-external-approval-demo.mjs",
    "e2e:external-email-approval": "cd apps/api && PXM_DEMO_AUTO_COMPLETE=true node scripts/create-external-approval-demo.mjs",
    "e2e:workflow-lifecycle": "cd apps/api && node scripts/smoke-workflow-lifecycle.mjs",
    "smoke:mongo:approval": "cd apps/api && API_BASE_URL=${API_BASE_URL:-http://localhost:3011/api} MONGODB_URL=${MONGODB_URL:-mongodb://127.0.0.1:27017/?replicaSet=rs0} MONGO_DB_NAME=${MONGO_DB_NAME:-pxm_db} node scripts/smoke-mongo-approval.mjs",
    "smoke:mongo:gateway": "cd apps/api && API_BASE_URL=${API_BASE_URL:-http://localhost:3011/api} MONGODB_URL=${MONGODB_URL:-mongodb://127.0.0.1:27017/?replicaSet=rs0} MONGO_DB_NAME=${MONGO_DB_NAME:-pxm_db} node scripts/smoke-mongo-gateway.mjs",
    "benchmark:immediate": "cd apps/api && node scripts/benchmark-immediate-nodes.mjs",
    "benchmark:schedule": "cd apps/api && node scripts/benchmark-schedule-start.mjs",
    "benchmark:cleanup": "cd apps/api && node scripts/cleanup-benchmark-data.mjs",
    "audit:prod": "pnpm audit --prod",
    "dev": "pnpm -r --parallel dev",
    "dev:api:mongo": "cd apps/api && PORT=${PORT:-3011} DB_TYPE=mongodb MONGODB_URL=${MONGODB_URL:-mongodb://127.0.0.1:27017/?replicaSet=rs0} MONGO_DB_NAME=${MONGO_DB_NAME:-pxm_db} pnpm dev",
    "dev:engine:mongo": "cd apps/engine && DB_TYPE=mongodb MONGODB_URL=${MONGODB_URL:-mongodb://127.0.0.1:27017/?replicaSet=rs0} MONGO_DB_NAME=${MONGO_DB_NAME:-pxm_db} cargo run",
    "dev:plugin-host": "cd apps/plugin-host && PORT=${PORT:-3010} pnpm dev",
    "dev:web": "cd apps/web && pnpm dev",
    "dev:api-playground": "pnpm --dir apps/api-playground dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint"
  }
}
