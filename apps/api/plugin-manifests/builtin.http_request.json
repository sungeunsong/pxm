{
  "plugin_id": "builtin.http_request",
  "version": "1.0.0",
  "display_name": "HTTP Request",
  "description": "Call an arbitrary HTTP endpoint from a service node.",
  "category": "Builtin",
  "node_type": "service",
  "icon": "globe",
  "config_schema": {
    "type": "object",
    "properties": {
      "url": { "type": "string", "title": "Request URL" },
      "method": {
        "type": "string",
        "title": "HTTP Method",
        "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"],
        "default": "GET"
      },
      "headers": { "type": "object", "title": "Headers" },
      "body": { "type": "object", "title": "JSON Body" },
      "timeout_ms": { "type": "integer", "title": "Timeout (ms)", "default": 5000 }
    },
    "required": ["url"]
  },
  "executor_type": "builtin",
  "executor_ref": "builtin.http_request",
  "secrets_policy": {},
  "input_schema": {
    "type": "object",
    "properties": {}
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "status_code": { "type": "integer" },
      "body": { "type": "object" }
    }
  },
  "timeout_ms": 5000,
  "retry_policy": {
    "max_attempts": 3,
    "backoff_ms": 1000
  },
  "tags": ["http", "webhook", "builtin"]
}
