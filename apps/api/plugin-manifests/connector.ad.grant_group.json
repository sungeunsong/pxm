{
  "plugin_id": "connector.ad.grant_group",
  "version": "1.0.0",
  "display_name": "AD Grant Group",
  "description": "Add a user to an Active Directory group.",
  "category": "Access",
  "node_type": "service",
  "icon": "users",
  "config_schema": {
    "type": "object",
    "properties": {
      "groupDn": { "type": "string", "title": "Group DN" },
      "userTemplate": { "type": "string", "title": "User Template" }
    },
    "required": ["groupDn", "userTemplate"]
  },
  "executor_type": "hosted",
  "executor_ref": "pxm-plugin-host:connector.ad.grant_group",
  "secrets_policy": {
    "required": {
      "bind_password": "secret://ad/bind_password"
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "group": { "type": "string" },
      "user": { "type": "string" }
    }
  },
  "timeout_ms": 7000,
  "retry_policy": {
    "max_attempts": 2,
    "backoff_ms": 1500
  },
  "tags": ["ad", "directory", "group"]
}
